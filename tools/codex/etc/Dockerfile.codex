# syntax=docker/dockerfile:1
FROM ubuntu:24.04

ARG HOST_UID=1000
ARG HOST_GID=1000

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  bash \
  bash-completion \
  sudo \
  curl \
  openssh-client \
  build-essential \
  git \
  vim \
  gnupg \
  bubblewrap \
  zlib1g-dev \
  libffi-dev \
  libssl-dev \
  libsqlite3-dev \
  libbz2-dev \
  liblzma-dev \
  libreadline-dev \
  libncurses-dev \
  libgdbm-dev \
  libgdbm-compat-dev \
  tk-dev \
  uuid-dev \
  xz-utils \
  python3 \
  python3-pip \
  python3-venv \
  python3-dev \
  python3-setuptools \
  python3-wheel \
  python3-yaml \
  && rm -rf /var/lib/apt/lists/*


# Install Docker CLI so the container can talk to the host daemon via the mounted socket
RUN curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu noble stable" \
  > /etc/apt/sources.list.d/docker.list && \
  apt-get update && apt-get install -y --no-install-recommends docker-ce-cli

# Add ubuntu user to sudoers
RUN echo 'ubuntu ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers

# Assign current user's uid:gid to ubuntu user inside the image so files
# written into host-mounted volumes ($HOME/.codex, the workdir) stay owned
# by the caller instead of the baked-in uid 1000.
RUN if [ "$HOST_GID" != "1000" ]; then groupmod -g "$HOST_GID" ubuntu; fi && \
  if [ "$HOST_UID" != "1000" ]; then usermod  -u "$HOST_UID" -g "$HOST_GID" ubuntu; fi && \
  chown -R "$HOST_UID:$HOST_GID" /home/ubuntu

USER ubuntu
WORKDIR /home/ubuntu

# Installs standalone Codex into its installer-managed staging path
RUN curl -fsSL https://chatgpt.com/codex/install.sh | sh

# Keeps executable outside /home/ubuntu/.codex because runtime bind mount replaces that tree
USER root
RUN test -x /home/ubuntu/.codex/packages/standalone/current/bin/codex && \
  mkdir -p /opt/codex && \
  cp -a /home/ubuntu/.codex/packages/standalone/current/. /opt/codex/ && \
  ln -s /opt/codex/bin/codex /usr/local/bin/codex && \
  rm -f /home/ubuntu/.local/bin/codex && \
  ln -s /usr/local/bin/codex /home/ubuntu/.local/bin/codex && \
  /usr/local/bin/codex --version

USER ubuntu
ENV PATH="/home/ubuntu/.local/bin:${PATH}"

# Create an entrypoint script
RUN cat > /home/ubuntu/entrypoint.sh <<'EOF'
#!/bin/bash

exec codex "$@"
EOF
RUN chmod +x /home/ubuntu/entrypoint.sh

# Run codex as the default command
ENTRYPOINT ["/home/ubuntu/entrypoint.sh"]
