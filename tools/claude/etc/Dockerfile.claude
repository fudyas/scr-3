# syntax=docker/dockerfile:1
FROM ubuntu:24.04

ARG HOST_UID=1000
ARG HOST_GID=1000

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    bash \
    bash-completion \
    sudo \
    curl \
    openssh-client \
    gnupg \
    build-essential \
    git \
    vim \
    bubblewrap \
    jq \
    zlib1g-dev \
    libffi-dev \
    libssl-dev \
    libsqlite3-dev \
    libbz2-dev \
    liblzma-dev \
    libreadline-dev \
    libncurses-dev \
    libgdbm-dev \
    libgdbm-compat-dev \
    tk-dev \
    uuid-dev \
    xz-utils \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    python3-setuptools \
    python3-wheel \
    python3-yaml \
    dnsutils \
    iproute2 \
    iputils-ping \
    netcat-openbsd \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI so the container can talk to the host daemon via the mounted socket
RUN curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu noble stable" \
    > /etc/apt/sources.list.d/docker.list && \
    apt-get update && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin

# Playwright Chromium runtime libs (Ubuntu 24.04 / Noble t64 variants) plus fonts.
# Browser binaries themselves are downloaded by `npx playwright install` at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0t64 \
    libatk-bridge2.0-0t64 \
    libcups2t64 \
    libxkbcommon0 \
    libatspi2.0-0t64 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libcairo2 \
    libpango-1.0-0 \
    libasound2t64 \
    fonts-liberation \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# Add ubuntu user to sudoers
RUN echo 'ubuntu ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers


# Assign current user's uid:gid to ubuntu user inside the image 
RUN if [ "$HOST_GID" != "1000" ]; then groupmod -g "$HOST_GID" ubuntu; fi && \
    if [ "$HOST_UID" != "1000" ]; then usermod  -u "$HOST_UID" -g "$HOST_GID" ubuntu; fi && \
    chown -R "$HOST_UID:$HOST_GID" /home/ubuntu

USER ubuntu
WORKDIR /home/ubuntu

# Install Claude using the native installer
RUN curl -fsSL https://claude.ai/install.sh | bash
RUN echo 'export PATH="$HOME/.local/bin:$PATH"' >> /home/ubuntu/.bashrc

# Create an entrypoint script
RUN printf '%s\n' '#!/bin/bash -i' '' 'exec claude "$@"' > /home/ubuntu/entrypoint.sh \
 && chmod +x /home/ubuntu/entrypoint.sh

# Run claude as the default command
ENTRYPOINT ["/home/ubuntu/entrypoint.sh"]

