# Test default only. Client owns production safe-mode service inventory.
set daemon 5
set pidfile /run/monit.pid
set statefile /var/lib/monit/state
set idfile /var/lib/monit/id
set logfile /var/log/monit.log

check process watchdog with pidfile /var/run/watchdog.pid
    start program = "/etc/init.d/watchdog start" with timeout 30 seconds
