#!/bin/sh
### BEGIN INIT INFO
# Provides:          watchdog
# Required-Start:    $all
# Required-Stop:     $all
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Coordinate native watchdog with selected MONIT
### END INIT INFO

# Native status is read-only. Serialize every change with MONIT lifecycle actions.
case "$1" in
    start|stop|restart|force-reload) exec /usr/bin/scr-raom watchdog "$1" ;;
    status) exec /usr/share/scr-raom/diverted/etc/init.d/watchdog "$@" ;;
    *) printf 'Usage: %s {start|stop|status|restart|force-reload}\n' "$0" >&2; exit 2 ;;
esac
