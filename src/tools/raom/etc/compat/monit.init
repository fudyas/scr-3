#!/bin/sh
### BEGIN INIT INFO
# Provides:          monit
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Should-Start:      $all
# Should-Stop:       $all
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: MONIT with per-boot RAOM profile selection
### END INIT INFO

# Preserve native stop/status; all actions that launch or reload use RAOM.
case "$1" in
    start|restart|force-reload|reload|syntax) exec /usr/bin/scr-raom monit "$1" ;;
    stop|status) exec /usr/share/scr-resets-monitor/diverted/etc/init.d/monit "$@" ;;
    *) printf 'Usage: %s {start|stop|status|restart|force-reload|reload|syntax}\n' "$0" >&2; exit 2 ;;
esac
