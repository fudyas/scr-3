#!/bin/bash

# Source and installed symlinks resolve to the same bin/ entry and SCR_HOME layout.
SCRIPT=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 2
export SCR_HOME
SCR_HOME=$(cd -- "${SCRIPT%/*}/.." && pwd -P) || exit 2

# Load the same configuration and shared libraries in either location.
source "$SCR_HOME/etc/scr.conf" || exit 2
[ ! -f "$SCR_HOME/etc/local.scr.conf" ] || source "$SCR_HOME/etc/local.scr.conf" || exit 2

for library in "$SCR_LIB_DIR"/*.sh; do
    [ -f "$library" ] || continue
    source "$library" || abort "failed to load source: $library"
done

# Load reusable runtime modules; do not source package builders or executable wrappers.
for module in "$SCR_RESETS_MONITOR_SRC_DIR/runtime"/*.sh; do
    source "$module" || exit 2
done

# Load the command layer, then run the selected operation.
source "$SRC_TOOLS_DIR/resets-monitor/tool.sh" || exit 2
[ "${BASH_SOURCE[0]}" != "$0" ] || main "$@"
